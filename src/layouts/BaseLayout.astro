---
import '../styles/global.css';
import { assetUrl } from '../config/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f1e5" />
    <link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg')} />
    <link rel="apple-touch-icon" href={assetUrl('apple-touch-icon.png')} />
    <title>{title}</title>
    {umamiWebsiteId && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId}></script>}
  </head>
  <body>
    <slot />
  </body>
</html>
